# PostgreSQL
POSTGRES_DB=nome_do_banco
POSTGRES_USER=usuario_ficticio
POSTGRES_PASSWORD=senha_ficticia_123

# PSN (token de 64 caracteres obtido em https://ca.account.sony.com/api/v1/ssocookie)
NPSSO_TOKEN=token_npsso_ficticio_de_64_caracteres

# Sidecar: cache das respostas de troféus em ms (default 600000 = 10 minutos)
TROFEUS_CACHE_TTL_MS=600000

# RabbitMQ (fila de sincronização assíncrona)
RABBITMQ_USER=trophix
RABBITMQ_PASSWORD=trophix

# E-mail (dev usa o Mailpit embutido no docker-compose)
# SMTP do Mailpit: localhost:1025 (sem auth) | UI: http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@trophix.com

# URL do front-end (base do link de redefinição de senha)
TROPHIX_WEB_URL=http://localhost:4200