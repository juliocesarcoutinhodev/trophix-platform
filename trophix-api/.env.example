# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/nome_do_banco
POSTGRES_USER=usuario_ficticio
POSTGRES_PASSWORD=senha_ficticia_123

# JWT (segredo em Base64 com pelo menos 32 bytes)
JWT_SECRET=segredo_base64_ficticio_para_documentacao

# Admin inicial (opcional em dev - ha default no application-dev.yml; em prod e obrigatorio)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=senha_admin_ficticia
ADMIN_PSN_ID=AdminFicticio

# Google GenAI (Gemini) - geracao de guias com IA
# Gere uma chave em https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=chave_gemini_ficticia
GOOGLE_AI_MODEL=gemini-3.6-flash

# RabbitMQ (fila assincrona de sync e de geracao de guias por IA)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=trophix
RABBITMQ_PASSWORD=trophix

# E-mail (dev usa o Mailpit: localhost:1025 sem auth | UI: http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@trophix.com

# URL do front-end (base do link de redefinicao de senha / forum)
TROPHIX_WEB_URL=http://localhost:4200

# CORS permitido (prod; dev usa default http://localhost:4200)
TROPHIX_CORS_ORIGIN=http://localhost:4200

# URL do sidecar PSN
TROPHIX_SIDECAR_BASEURL=http://localhost:3000

# MinIO (S3-compatible) - imagens de guias e avatares
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=trophix-media
MINIO_PUBLIC_URL=http://localhost:9000
