              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register-completion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register-completion"]
            },
            "description": "Finaliza o cadastro do usuário vinculado à PSN: define e-mail, senha (BCrypt) e a role ROLE_USER.\n\nRespostas:\n- 200: cadastro realizado\n- 400: dados inválidos (mensagens em PT-BR)\n- 409: e-mail já em uso"
          },
          "response": [
            {
              "name": "Cadastro realizado (200)",
