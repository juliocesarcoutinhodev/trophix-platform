    {
      "name": "Troféus Conquistados do Jogador",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/jogos/{{npCommunicationId}}/trofeus-conquistados/{{accountId}}",
