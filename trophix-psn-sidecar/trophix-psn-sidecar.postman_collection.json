{
  "info": {
    "name": "Trophix PSN Sidecar",
    "description": "Coleção para testar o microsserviço sidecar Trophix-PSN (Node.js/Express).\n\nPré-requisito: sidecar rodando com `npm start` e NPSSO configurado no .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "psnId",
      "value": "Cout1nh030",
      "type": "string",
      "description": "Online ID de um usuário PSN (público)"
    },
    {
      "key": "npCommunicationId",
      "value": "PPSA01234",
      "type": "string",
      "description": "ID de comunicação do jogo. PS5 começa com PPSA, PS4 com CUSA, PS3 com NPUA/NPJB, PS Vita com PCS"
    },
    {
      "key": "accountId",
      "value": "962157895908076652",
      "type": "string",
      "description": "ID numérico da conta PSN. Obtenha pela resposta do endpoint Resumo de Nível e Troféus do Jogador"
    }
  ],
  "item": [
    {
      "name": "Validar Perfil de Usuário",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/perfil/{{psnId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "perfil", "{{psnId}}"]
        },
        "description": "Retorna o perfil público do usuário: psnId, aboutMe e avatarUrl.\n\nRespostas:\n- 200: perfil encontrado\n- 404: perfil privado ou inexistente\n- 502: falha na consulta à PSN"
      },
      "response": [
        {
          "name": "Perfil encontrado (200)",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/perfil/{{psnId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "perfil", "{{psnId}}"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            { "key": "Content-Type", "value": "application/json; charset=utf-8" }
          ],
          "body": "{\n    \"psnId\": \"julio\",\n    \"aboutMe\": \"Sou um gamer\",\n    \"avatarUrl\": \"https://psncst-ei.secure.playstation.com/avatar/THM/60b.png\"\n}"
        },
        {
          "name": "Perfil privado ou inexistente (404)",
